
#include <stdio.h>
#include <string.h>

int main()
{
    char names[10][50];
    char temp[50];

    printf("Enter 10 student names:\n");

    for (int i = 0; i < 10; i++)
    {
        printf("Enter name %d: ", i + 1);
        scanf(" %49[^\n]", names[i]);
    }

    // Sorting names alphabetically
    for (int i = 0; i < 9; i++)
    {
        for (int j = i + 1; j < 10; j++)
        {
            if (strcmp(names[i], names[j]) > 0)
            {
                strcpy(temp, names[i]);
                strcpy(names[i], names[j]);
                strcpy(names[j], temp);
            }
        }
    }

    printf("\nNames in alphabetical order:\n");

    for (int i = 0; i < 10; i++)
    {
        printf("%s\n", names[i]);
    }

    return 0;
}
